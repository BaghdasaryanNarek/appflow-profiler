{
  "$defs": {
    "AnalyzeRequest": {
      "additionalProperties": false,
      "description": "Request payload for triggering an on-demand architectural review.",
      "properties": {
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional targeted focus area (e.g., latency, pooling)",
          "title": "Focus"
        },
        "scope": {
          "default": "global",
          "description": "Analysis scope: 'global' or a specific node_id",
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "AnalyzeRequest",
      "type": "object"
    },
    "Bottleneck": {
      "additionalProperties": false,
      "description": "Diagnosed architectural bottleneck linked to specific telemetry evidence.",
      "properties": {
        "evidence": {
          "description": "Observable metrics or threshold violations grounding the claim",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "node_id": {
          "description": "Impacted entity identifier",
          "title": "Node Id",
          "type": "string"
        },
        "severity": {
          "description": "Operational impact level",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "description": "Concise description of the constraint",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "title",
        "severity",
        "evidence"
      ],
      "title": "Bottleneck",
      "type": "object"
    },
    "OptimizationReport": {
      "additionalProperties": false,
      "description": "Complete architectural optimization report generated by Gemini or heuristic fallback.",
      "properties": {
        "bottlenecks": {
          "items": {
            "$ref": "#/$defs/Bottleneck"
          },
          "title": "Bottlenecks",
          "type": "array"
        },
        "caveats": {
          "description": "Observability blindspots or data quality qualifications",
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "digest_hash": {
          "description": "SHA-256 fingerprint of the topology digest evaluated",
          "title": "Digest Hash",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cloud LLM model identifier if LLM-backed",
          "title": "Model"
        },
        "recommendations": {
          "items": {
            "$ref": "#/$defs/Recommendation"
          },
          "title": "Recommendations",
          "type": "array"
        },
        "report_id": {
          "description": "Unique report execution identifier",
          "title": "Report Id",
          "type": "string"
        },
        "source": {
          "description": "Intelligence engine generating report",
          "enum": [
            "gemini",
            "heuristic"
          ],
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "description": "High-level executive architectural summary",
          "maxLength": 600,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "source",
        "digest_hash",
        "summary"
      ],
      "title": "OptimizationReport",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "Actionable infrastructure or configuration optimization proposal.",
      "properties": {
        "affected_node_ids": {
          "description": "Topology node IDs directly targeted by this recommendation",
          "items": {
            "type": "string"
          },
          "title": "Affected Node Ids",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/RecommendationCategory",
          "description": "Domain classification"
        },
        "effort": {
          "description": "Estimated engineering implementation effort",
          "enum": [
            "S",
            "M",
            "L"
          ],
          "title": "Effort",
          "type": "string"
        },
        "expected_impact": {
          "description": "Anticipated latency or capacity gains",
          "title": "Expected Impact",
          "type": "string"
        },
        "id": {
          "description": "Deterministic recommendation ID (e.g. rec-pool-orders)",
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "description": "1 (Urgent/Critical) to 5 (Informational/Low)",
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "rationale": {
          "description": "Technical explanation grounded in observations",
          "title": "Rationale",
          "type": "string"
        },
        "title": {
          "description": "Executive recommendation summary",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "priority",
        "rationale",
        "expected_impact",
        "affected_node_ids",
        "effort"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationCategory": {
      "description": "Categorical domain of optimization advice.",
      "enum": [
        "capacity",
        "connection_pooling",
        "caching",
        "retry_policy",
        "topology",
        "timeouts",
        "observability"
      ],
      "title": "RecommendationCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate bundle generating schemas for Optimization Advisor requests and reports.",
  "properties": {
    "report": {
      "$ref": "#/$defs/OptimizationReport"
    },
    "request": {
      "$ref": "#/$defs/AnalyzeRequest"
    }
  },
  "required": [
    "report",
    "request"
  ],
  "title": "InsightsSchemaBundle",
  "type": "object"
}
