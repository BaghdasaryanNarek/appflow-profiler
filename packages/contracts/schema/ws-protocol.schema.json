        "error_rate": {
          "description": "Fraction of requests failing",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Error Rate",
          "type": "number"
        },
        "open_connections": {
          "description": "Total active socket handles",
          "minimum": 0,
          "title": "Open Connections",
          "type": "integer"
        },
        "p50_ms": {
          "description": "50th percentile latency in milliseconds",
          "minimum": 0.0,
          "title": "P50 Ms",
          "type": "number"
        },
        "p99_ms": {
          "description": "99th percentile latency in milliseconds",
          "minimum": 0.0,
          "title": "P99 Ms",
          "type": "number"
        },
        "quality": {
          "$ref": "#/$defs/MetricQuality",
          "description": "Telemetry fidelity indicator"
        },
        "rps": {
          "description": "Requests per second",
          "minimum": 0.0,
          "title": "Rps",
          "type": "number"
        },
        "rss_bytes": {
          "description": "Resident memory size in bytes",
          "minimum": 0,
          "title": "Rss Bytes",
          "type": "integer"
        },
        "saturation": {
          "description": "Capacity utilization ratio [0.0, 1.0]",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Saturation",
          "type": "number"
        }
      },
      "required": [
        "rps",
        "p50_ms",
        "p99_ms",
        "error_rate",
        "saturation",
        "cpu_percent",
        "rss_bytes",
        "open_connections",
        "quality"
      ],
      "title": "NodeMetrics",
      "type": "object"
    },
