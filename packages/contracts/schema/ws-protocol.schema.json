    "ConnState": {
      "description": "TCP socket connection lifecycle states.",
      "enum": [
        "ESTABLISHED",
        "SYN_SENT",
        "SYN_RECV",
        "FIN_WAIT1",
        "FIN_WAIT2",
        "TIME_WAIT",
        "CLOSE",
        "CLOSE_WAIT",
        "LAST_ACK",
        "LISTEN",
        "CLOSING",
        "NONE"
      ],
      "title": "ConnState",
      "type": "string"
    },
    "DeltaPayload": {
      "additionalProperties": false,
      "description": "Incremental topology diff payload applied over base_seq.",
      "properties": {
        "added_edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "title": "Added Edges",
          "type": "array"
        },
        "added_nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "title": "Added Nodes",
          "type": "array"
        },
        "base_seq": {
          "description": "Sequence delta builds upon",
          "minimum": 0,
          "title": "Base Seq",
          "type": "integer"
        },
        "removed_edge_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Edge Ids",
          "type": "array"
        },
        "removed_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Removed Node Ids",
          "type": "array"
        },
        "updated_edges": {
          "items": {
            "$ref": "#/$defs/EdgePatch"
          },
          "title": "Updated Edges",
          "type": "array"
        },
        "updated_nodes": {
          "items": {
            "$ref": "#/$defs/NodePatch"
          },
          "title": "Updated Nodes",
          "type": "array"
        }
      },
      "required": [
        "base_seq"
      ],
      "title": "DeltaPayload",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Directed connection between two topology nodes.",
      "properties": {
        "health": {
          "$ref": "#/$defs/HealthStatus",
          "description": "Derived edge health status"
        },
        "id": {
          "description": "Deterministic edge identifier",
          "title": "Id",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/EdgeMetrics",
          "description": "Communication telemetry"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol",
          "description": "Observed protocol"
        },
        "source": {
          "description": "Source node ID",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "description": "Target node ID",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "protocol",
        "health",
        "metrics"
      ],
      "title": "Edge",
      "type": "object"
    },
    "EdgeMetrics": {
      "additionalProperties": false,
      "description": "Traffic and socket state breakdown for a directed communication edge.",
      "properties": {
        "bytes_per_sec": {
          "description": "Byte throughput rate",
          "minimum": 0.0,
          "title": "Bytes Per Sec",
          "type": "number"
        },
        "connection_count": {
          "description": "Observed concurrent socket count",
          "minimum": 0,
          "title": "Connection Count",
          "type": "integer"
        },
        "error_rate": {
          "description": "Edge communication error rate",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Error Rate",
          "type": "number"
        },
        "p99_ms": {
          "description": "99th percentile round-trip latency in ms",
          "minimum": 0.0,
          "title": "P99 Ms",
          "type": "number"
        },
        "quality": {
          "$ref": "#/$defs/MetricQuality",
          "description": "Telemetry fidelity indicator"
        },
        "retry_rate": {
          "default": 0.0,
          "description": "Retry amplification ratio",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Retry Rate",
          "type": "number"
        },
        "rps": {
          "description": "Requests per second flowing across edge",
          "minimum": 0.0,
          "title": "Rps",
          "type": "number"
        },
        "state_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Sockets per TCP state",
          "propertyNames": {
            "$ref": "#/$defs/ConnState"
          },
          "title": "State Breakdown",
          "type": "object"
        }
      },
      "required": [
        "rps",
        "bytes_per_sec",
        "p99_ms",
        "error_rate",
        "connection_count",
        "quality"
      ],
      "title": "EdgeMetrics",
      "type": "object"
    },
