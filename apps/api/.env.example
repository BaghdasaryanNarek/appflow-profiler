# AppFlow Profiler Backend — Environment Configuration Template (Master Plan §6.5)
# Copy to apps/api/.env for local overrides. Never commit real secrets.

# Telemetry source mode: live (psutil OS sockets) | demo (M/M/c simulator) | test
ENV=demo

# Sampling and WebSocket broadcast cadence
TICK_MS=1000
SNAPSHOT_EVERY_S=30
MAX_WS_CLIENTS=50

# CORS & WebSocket Origin allowlist (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://appflow-profiler.vercel.app
# Optional domain suffix allowlist for HTTPS preview deployments (e.g. .vercel.app)
ALLOWED_ORIGIN_SUFFIXES=.vercel.app

# Simulation engine parameters
SIM_SEED=42
SIM_SCALE=1.0
SIM_AUTOPLAY=true

# Optimization Advisor (Gemini Interactions API; falls back to deterministic heuristics if unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ADVISOR_TIMEOUT_S=25

# Structured logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
