# AppFlow Profiler Frontend — Environment Configuration Template (Master Plan §6.4, Phase 17)
# Copy to apps/web/.env.local for local development or configure in Vercel Project Settings.

# Local Development Defaults:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/topology

# Production (Vercel -> Render) Example:
# NEXT_PUBLIC_API_URL=https://appflow-api.onrender.com
# NEXT_PUBLIC_API_BASE_URL=https://appflow-api.onrender.com
# NEXT_PUBLIC_WS_URL=wss://appflow-api.onrender.com/ws/v1/topology
