# AppFlow Profiler — Monorepo Environment Template (Master Plan §6.5, Phase 17)
# Copy to .env for local development. NEVER commit .env to version control.

# --- Backend (apps/api) ---
ENV=demo
TICK_MS=1000
SNAPSHOT_EVERY_S=30
MAX_WS_CLIENTS=50
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://appflow-profiler.vercel.app
ALLOWED_ORIGIN_SUFFIXES=.vercel.app
SIM_SEED=42
SIM_SCALE=1.0
SIM_AUTOPLAY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ADVISOR_TIMEOUT_S=25
LOG_LEVEL=INFO

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/topology
